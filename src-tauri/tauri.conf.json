{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BritPDF",
  "version": "1.0.0",
  "identifier": "com.britoffice.britpdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BritPDF",
        "width": 1280,
        "height": 840,
        "minWidth": 1152,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": null,
        "dragDropEnabled": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALAPPDATA/**"]
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) BritOffice",
    "category": "Productivity",
    "shortDescription": "Read, edit and print PDF files",
    "longDescription": "BritPDF is an offline PDF viewer and editor for Windows. It opens, edits, annotates, signs, converts, prints and protects PDF files entirely on your own computer.",
    "publisher": "BritOffice",
    "resources": ["vendor/pdfium/bin/pdfium.dll", "THIRD-PARTY-NOTICES.md"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}

